{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human-labeled query expansion conversation",
  "type": "object",
  "required": ["conversation_id", "source_note", "messages"],
  "properties": {
    "conversation_id": {"type": "string", "minLength": 1},
    "source_note": {"type": "string", "description": "Approved source/collection note; do not put personal data here."},
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["message_id", "role", "text"],
        "properties": {
          "message_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["user", "assistant"]},
          "text": {"type": "string"},
          "gold": {
            "type": ["object", "null"],
            "description": "Required on user messages; leave null on assistant messages.",
            "properties": {
              "topic_l1": {"enum": ["Politics", "Sports", "Technology", "Entertainment", "Health", "History", "Geography", "General"]},
              "topic_l2": {"type": "string"},
              "needs_clarification": {"type": "boolean"},
              "reference_expansion": {"type": ["string", "null"]},
              "clarification_question": {"type": ["string", "null"]}
            }
          },
          "prediction": {
            "type": ["object", "null"],
            "description": "Fill for model runs on the held-out split; reviewed fields must be completed by a human.",
            "properties": {
              "topic_l1": {"type": "string"},
              "topic_l2": {"type": "string"},
              "needs_clarification": {"type": "boolean"},
              "expanded_query": {"type": "string"},
              "intent_preserved": {"type": ["boolean", "null"]},
              "unsupported_details": {"type": ["boolean", "null"]}
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
